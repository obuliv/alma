# Postgres
POSTGRES_USER=alma
POSTGRES_PASSWORD=alma
POSTGRES_DB=alma

# Upload constraints
MAX_UPLOAD_MB=10

# LLM (data extraction + form-field mapping)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=60
OCR_MODE=llm

# Browser automation (stream 3)
FORM_URL=
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# NOTE: DATABASE_URL and UPLOAD_DIR are set for the api service in
# docker-compose.yml. Override here only if running the backend outside Docker.
#
# Form-fill opens a VISIBLE browser, which only works on a host with a
# display. Run Postgres in Docker (`docker compose up -d db`, exposed on
# localhost:5432) and the API on your host (see CLAUDE.md), setting:
#   DATABASE_URL=postgresql+psycopg://alma:alma@localhost:5432/alma
