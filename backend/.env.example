# DATABASE_URL and UPLOAD_DIR default to a local SQLite file (./data/alma.db)
# and ./data/uploads, both relative to this directory — override here only to
# customize the location.

# Upload constraints
MAX_UPLOAD_MB=10

# LLM (data extraction + form-field mapping)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=60
OCR_MODE=llm

# Browser automation (stream 3)
FORM_URL=
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# Form-fill opens a VISIBLE browser, which only works on a host with a
# display — run the API as a normal local process (see README), not headless.
